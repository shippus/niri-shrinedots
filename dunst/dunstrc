# ~/.config/dunst/dunstrc

[global]
    monitor = 0
    follow = mouse

    width = (300, 420)
    height = (0, 300)
    origin = top-right
    offset = (8, 46)
    scale = 0
    notification_limit = 5
    gap_size = 6

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 4
    progress_bar_min_width = 150
    progress_bar_max_width = 400

    indicate_hidden = yes
    transparency = 0
    separator_height = 4
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 1
    frame_color = "#C9242B4D"
    separator_color = frame
    corner_radius = 10
    corners = all
    sort = urgency_descending

    font = Maple Mono 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    show_age_threshold = 60
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    enable_recursive_icon_lookup = true
    icon_theme = "Hatter-Red"
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/fuzzel --dmenu
    browser = /usr/bin/xdg-open
    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#0C0808E0"
    foreground = "#7A4A44"
    highlight = "#C9242B"
    frame_color = "#C9242B2B"
    timeout = 5

[urgency_normal]
    background = "#0C0808E0"
    foreground = "#F5EAD0"
    highlight = "#C9242B"
    frame_color = "#C9242B4D"
    timeout = 8

[urgency_critical]
    background = "#0C0808F2"
    foreground = "#F5EAD0"
    highlight = "#C9242B"
    frame_color = "#C9242B"
    timeout = 0

# Example rule: silence notifications from a given app
